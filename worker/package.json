{
  "name": "gemba-audit-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:schema": "wrangler d1 execute gemba-audit --remote --file=./schema.sql",
    "db:seed": "wrangler d1 execute gemba-audit --remote --file=./seed.sql",
    "db:schema:local": "wrangler d1 execute gemba-audit --local --file=./schema.sql",
    "db:seed:local": "wrangler d1 execute gemba-audit --local --file=./seed.sql"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "wrangler": "^4.124.0"
  }
}
