{
  "name": "gemba-safety-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:ghpages": "vite build --base=/Gemba-Safety/",
    "build:file": "vite build --base=./",
